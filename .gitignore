# =============================================================
#  Служебное, кеш, окружение
# =============================================================
.voxel_cache/          # кеш вокселизации CSV, восстанавливается сам
__pycache__/
*.py[cod]
*.so
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.vscode/
.idea/
.venv/
venv/
env/
*.egg-info/
*.tmp
*.log
*.bak

# =============================================================
#  Крупные данные — пойдут отдельно через git lfs
# =============================================================
# Исходные треки из GEANT4/SRIM (~1.7 ГБ)
*.csv

# Интерактивные 3D-карты plotly (~0.9 ГБ, по 300 МБ на файл)
*.html

# Результаты расчёта: массивы (~156 МБ, один файл 106 МБ —
# GitHub не принимает файлы больше 100 МБ без lfs).
# Паспорта .json и картинки .png остаются в репозитории,
# а сами массивы восстанавливаются запуском run_wall_load.py за секунды.
*.npz

# -------------------------------------------------------------
# Когда дойдёт до git lfs: .gitignore сильнее, чем git add,
# поэтому либо уберите нужную строку выше, либо добавляйте явно:
#   git lfs install
#   git lfs track "*.csv"
#   git add .gitattributes
#   git add -f "Effective traks/primary_de_points_20_MeV.csv"
# -------------------------------------------------------------
